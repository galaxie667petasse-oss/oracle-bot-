FROM python:3.12-slim
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1
COPY requirements.txt requirements-v11.txt ./
RUN pip install -r requirements.txt -r requirements-v11.txt
COPY . .
RUN useradd --create-home oracle && mkdir -p /app/variable && chown oracle:oracle /app/variable
USER oracle
EXPOSE 8000
CMD ["uvicorn", "v10.api:app", "--host", "0.0.0.0", "--port", "8000"]

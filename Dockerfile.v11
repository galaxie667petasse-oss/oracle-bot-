FROM python:3.12-slim@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 PIP_NO_CACHE_DIR=1
COPY requirements-v11-py312.lock.txt ./
RUN pip install -r requirements-v11-py312.lock.txt && pip check
COPY . .
RUN useradd --create-home oracle && mkdir -p /app/variable && chown oracle:oracle /app/variable
USER oracle
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8000/health/live', timeout=4)"
CMD ["uvicorn", "v11.api:app", "--host", "0.0.0.0", "--port", "8000"]

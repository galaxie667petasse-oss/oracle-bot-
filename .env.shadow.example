APP_ENV=staging
DRY_RUN=true
PAPER_BETTING_ENABLED=true
REAL_MONEY_ACTIONS_ENABLED=false
STATISTICAL_MODEL_VALIDATED_FOR_SIGNALS=false
LLM_ENABLED=false
LLM_SHADOW_ONLY=true
LLM_ALLOW_PAID_CALLS=false
TELEGRAM_ENABLED=false
TELEGRAM_DISABLE_SEND=true
OPENAI_BATCH_ENABLED=false
RAILWAY_ALLOW_DEPLOY=false

# Budgets shadow proposes, non actifs tant que LLM_ENABLED/LLM_ALLOW_PAID_CALLS restent false.
OPENAI_DAILY_BUDGET_USD=2.00
OPENAI_SCAN_BUDGET_USD=0.30
OPENAI_FIXTURE_BUDGET_USD=0.10
OPENAI_CANDIDATE_BUDGET_USD=0.08
OPENAI_SOL_CALL_BUDGET_USD=0.08
OPENAI_MAX_CANDIDATES_PER_SCAN=10
OPENAI_MAX_FINALISTS_PER_SCAN=3
OPENAI_MAX_SOL_CALLS_PER_SCAN=2
OPENAI_MAX_SOL_CALLS_PER_FIXTURE=1
OPENAI_FAST_MAX_INPUT_TOKENS=6000
OPENAI_FAST_MAX_OUTPUT_TOKENS=350
OPENAI_SPECIALIST_MAX_INPUT_TOKENS=10000
OPENAI_SPECIALIST_MAX_OUTPUT_TOKENS=700
OPENAI_FINAL_MAX_INPUT_TOKENS=12000
OPENAI_FINAL_MAX_OUTPUT_TOKENS=800
